{
  "name": "build-language-i18n-action",
  "description": "Building translation files for the i18n library",
  "version": "2.0.0",
  "author": "",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/actions/javascript-action#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/text-adi/build-language-i18n-action.git"
  },
  "bugs": {
    "url": "https://github.com/text-adi/build-language-i18n-action/issues"
  },
  "keywords": [
    "actions"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "package": "npx rimraf ./dist && npx rollup --config rollup.config.js",
    "local-action": "npx @github/local-action . src/main.js .env",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "package:watch": "npm run package -- --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/glob": "^0.6.1",
    "@rollup/plugin-json": "^6.1.0",
    "gettext-parser": "^9.0.2"
  },
  "devDependencies": {
    "@github/local-action": "^7.0.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "jest": "^30.3.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
